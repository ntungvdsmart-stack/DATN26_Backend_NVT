# Copy only required values to .env. Never commit actual merchant credentials.
# Public backend origin, without /api. Providers must be able to reach it over HTTPS.
PUBLIC_API_URL=https://api.your-domain.example
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Configure this IPN in the VNPay merchant portal:
# https://api.your-domain.example/api/payments/vnpay/ipn
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_CREATE_URL=https://test-payment.momo.vn/v2/gateway/api/create
# MoMo IPN is supplied automatically: /api/payments/momo/ipn
