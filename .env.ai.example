# Copy settings into backend/.env. Keep real keys out of frontend and source control.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Additional numbered keys are supported: GEMINI_API_KEY_4, GEMINI_API_KEY_5, ...
# Alternatively: GEMINI_API_KEYS=key_one,key_two,key_three
